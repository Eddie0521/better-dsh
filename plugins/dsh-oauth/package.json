{
  "name": "dsh-oauth",
  "version": "0.1.0",
  "description": "DSH 插件：为 pi-ai 适配层补上 OAuth 登录能力。支持 Anthropic、OpenRouter、GitHub Copilot、OpenAI Codex 等 provider 的 PKCE/Device Code 流程。登录后 token 自动写入 DSH credential store，pi-ai adapter 透明消费。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eddie0521/better-dsh"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oauth",
    "pi-ai",
    "auth"
  ],
  "license": "MIT",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
